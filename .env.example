# =============================================================================
# Gym Coach — environment variables
# Copy to .env.local for local development. Never commit real values.
# Validated at server start by src/server/config/env.ts (the server refuses to
# start if a required value is missing or invalid).
# Spec: docs/specs/configuration-and-constants.md
# =============================================================================

# App
NEXT_PUBLIC_SITE_URL=                   # Public origin of this deployment, no trailing slash. Local: http://localhost:3000. Production: https://<prod domain>. Leave UNSET on Vercel Preview (derived from VERCEL_URL). Used for the CSRF Origin check and auth email redirects.
APP_ENV=                                # SERVER ONLY — local | preview | production (CI uses local)
AGENTS_MODE=                            # SERVER ONLY — real | fake. fake = deterministic test agents, no Anthropic calls; rejected when APP_ENV=production

# Supabase
NEXT_PUBLIC_SUPABASE_URL=               # Project URL — Supabase dashboard > Project Settings > API (local: http://127.0.0.1:54321 from `supabase status`)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # Publishable key (formerly "anon") — Project Settings > API Keys (local: ANON_KEY from `supabase status -o env`). Browser uses it for Auth only.
SUPABASE_SECRET_KEY=                    # SERVER ONLY — Secret key (formerly "service_role") — Project Settings > API Keys (local: SERVICE_ROLE_KEY from `supabase status -o env`). Used only for account deletion and the image upload script; bypasses RLS, never expose to the client.

# Database (Supabase Postgres via Supavisor)
DATABASE_URL=                           # SERVER ONLY — Transaction pooler (port 6543) as role gc_app: postgresql://gc_app.<project-ref>:<gc_app password>@<pooler host>:6543/postgres. Host from Project Settings > Database > Connection pooling; password set once with `alter role gc_app with password '…'`. Local: postgresql://gc_app:gc_app_local@127.0.0.1:54322/postgres

# Anthropic (Claude API)
ANTHROPIC_API_KEY=                      # SERVER ONLY — API key from console.anthropic.com > Settings > API Keys, in workspace gym-coach-dev (local, preview) or gym-coach-prod (production). Optional only when AGENTS_MODE=fake.
ANTHROPIC_API_BASE_URL=                 # SERVER ONLY — Optional. Defaults to https://api.anthropic.com. Set explicitly so a stray ANTHROPIC_BASE_URL in a shell can't redirect calls.

# LLM spend guard
LLM_MONTHLY_BUDGET_USD=                 # SERVER ONLY — App-side monthly LLM budget (UTC month), checked before every agent call. 58 in production (Anthropic prod workspace limit $60); 24 in local and preview (dev workspace limit $25).

# Vercel (system variables — set automatically by Vercel; leave empty locally)
VERCEL_URL=                             # SERVER ONLY — Deployment host without scheme (e.g. fitness-coach-abc123.vercel.app). Used for SITE_URL and allowed origins on Preview.
VERCEL_BRANCH_URL=                      # SERVER ONLY — Branch alias host on Preview. Accepted as an allowed Origin on Preview.
VERCEL_GIT_COMMIT_SHA=                  # SERVER ONLY — Commit SHA of the deployment; returned as `version` by GET /api/v1/health ('local' when empty).

# Scripts — reference-data seed (pnpm db:seed --env dev|prod). Also GitHub Actions secrets.
SUPABASE_DB_URL_DEV=                    # SERVER ONLY — Dev project, session pooler (port 5432) as role postgres: postgresql://postgres.<dev-ref>:<db password>@<pooler host>:5432/postgres. Database password: Project Settings > Database.
SUPABASE_DB_URL_PROD=                   # SERVER ONLY — Prod project, same format as above. In GitHub, stored in the `production` environment (owner approval).
MIGRATION_DATABASE_URL=                 # SERVER ONLY — Optional. Database read by drizzle-kit introspect/check; defaults to the local stack (postgresql://postgres:postgres@127.0.0.1:54322/postgres).

# CI / CD only (GitHub Actions secrets — not needed in .env.local)
SUPABASE_ACCESS_TOKEN=                  # SERVER ONLY — Personal access token for the Supabase CLI — supabase.com/dashboard/account/tokens
VERCEL_TOKEN=                           # SERVER ONLY — Vercel access token for `vercel deploy --prod` — vercel.com/account/tokens
VERCEL_ORG_ID=                          # SERVER ONLY — Vercel team/user ID — .vercel/project.json after `vercel link`, or Team Settings > General
VERCEL_PROJECT_ID=                      # SERVER ONLY — Vercel project ID — .vercel/project.json, or Project Settings > General
ANTHROPIC_API_KEY_EVALS=                # SERVER ONLY — gym-coach-dev workspace key used by .github/workflows/evals.yml (pnpm evals:full)
